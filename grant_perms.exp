#!/usr/bin/expect -f
set timeout 10
spawn ssh -o StrictHostKeyChecking=no root@178.104.127.220 "docker exec -i supabase-db psql -U postgres -d postgres -c \"GRANT USAGE ON SCHEMA flexlearn_customization TO anon, authenticated, service_role; GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA flexlearn_customization TO anon, authenticated, service_role; GRANT ALL PRIVILEGES ON ALL ROUTINES IN SCHEMA flexlearn_customization TO anon, authenticated, service_role; GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA flexlearn_customization TO anon, authenticated, service_role; ALTER DEFAULT PRIVILEGES IN SCHEMA flexlearn_customization GRANT ALL ON TABLES TO anon, authenticated, service_role; ALTER DEFAULT PRIVILEGES IN SCHEMA flexlearn_customization GRANT ALL ON ROUTINES TO anon, authenticated, service_role; ALTER DEFAULT PRIVILEGES IN SCHEMA flexlearn_customization GRANT ALL ON SEQUENCES TO anon, authenticated, service_role; NOTIFY pgrst, 'reload schema';\""
expect "password:"
send "voibVmIdk9DqPMmZ\r"
